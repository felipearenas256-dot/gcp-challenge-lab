# Copia este archivo como lab.env (o ejecuta ./lab.sh configurar)
# y completa los valores que te da el panel del laboratorio en Google Skills.

PROJECT_ID=""        # ej: qwiklabs-gcp-01-1234abcd5678
ZONE=""              # ej: us-east1-b   (la región se calcula sola: us-east1)
BUCKET_NAME=""       # el nombre EXACTO que pide la Tarea 1 (normalmente el mismo PROJECT_ID)

# Estos nombres los fija el laboratorio; no los cambies.
INSTANCE_NAME="my-instance"
DISK_NAME="mydisk"
